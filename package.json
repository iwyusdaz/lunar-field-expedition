{
  "name": "lunar-field-expedition",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Land at the real Apollo 15 Hadley-Apennine site, rebuilt from NASA lunar terrain data. Read the landscape under changing sunlight, compare the ages of surfaces, plan a sampling traverse, and defend your findings in a field report.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-attribution.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:subpath": "playwright test tests/sub-path.spec.js",
    "check:a11y": "playwright test tests/a11y.spec.js",
    "build:poster": "node scripts/render-poster.mjs",
    "build:attribution": "node scripts/build-attribution.mjs",
    "validate:showcase": "node scripts/validate-showcase.mjs 2.0.0",
    "fetch:v3-assets": "node scripts/fetch-v3-assets.mjs",
    "build:v3-terrain": "node scripts/build-v3-terrain.mjs",
    "build:v3-textures": "node scripts/build-v3-textures.mjs",
    "build:v3-models": "node scripts/build-v3-models.mjs",
    "check:v3-assets": "node scripts/check-v3-assets.mjs"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
